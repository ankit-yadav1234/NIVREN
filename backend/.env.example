PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# AI Assistant (Google Gemini) — server-side only, never expose to the browser.
GOOGLE_API_KEY=
# Optional — defaults to gemini-3.6-flash if unset.
GEMINI_MODEL=gemini-3.6-flash
# RAG Embeddings — defaults to gemini-embedding-2 if unset.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Complex Reasoning Model (optional override)
GEMINI_PRO_MODEL=gemini-3.1-pro-preview

# Voice Agent (LiveKit) — server-side only, never expose to the browser.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
